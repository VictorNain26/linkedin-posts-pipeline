# Crontab Docker — lu par supercronic dans le container.

# ── Phase 1 : sélection article (mar/mer/jeu 08h00) ─────────
0 8 * * 2,3,4 cd /app && ./pipeline.sh --select-only

# ── Phase 2 : génération draft (mar/mer/jeu 09h00) ──────────
# Tourne 8 agents, génère PDF, sauvegarde state/pending_draft.json
# Envoie email de rappel si Gmail configuré.
0 9 * * 2,3,4 cd /app && ./pipeline.sh --draft

# ── Phase 3 : publication (mar/mer/jeu 10h30) ────────────────
# Publie seulement si state/approved existe (validation dashboard).
# Skip silencieux si non approuvé.
30 10 * * 2,3,4 cd /app && ./pipeline.sh

# ── Healthcheck daily 08h00 (lun/ven/sam/dim) ───────────────
0 8 * * 1,5,6,0 cd /app && ./healthcheck.sh

# ── Rapport hebdomadaire (lundi 07h00) ───────────────────────
0 7 * * 1 cd /app && ./weekly_report.sh

# ── Backup auto (daily 02h00) ─────────────────────────────────
0 2 * * * cd /app && ./backup.sh

# ── Cleanup espace disque (daily 03h00) ──────────────────────
0 3 * * * cd /app && ./cleanup.sh
