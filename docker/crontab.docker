# Crontab Docker — lu par supercronic dans le container.
# NE PAS confondre avec CRON_DISABLED.txt à la racine du repo
# (qui documente les crons pour install HOST native sans Docker).
#
# Ce fichier est chargé par supercronic au démarrage du container :
#   ENTRYPOINT [dumb-init] CMD [supercronic, -inotify, /app/crontab]
#
# Logs : supercronic logge sur stdout → consultable via `docker logs linkedin-pipeline`.
# Pas besoin de PATH manuel : Docker fournit /usr/local/bin par défaut.
# Format cron classique : minute hour day month weekday command

# Posts evergreen prospect — mardi + mercredi + jeudi 10h30
# (sweet spot LinkedIn 2026 : 3/sem, source Buffer 2M+ posts / van der Blom)
30 10 * * 2,3,4 cd /app && ./pipeline.sh

# Daily 8h — healthcheck
0 8 * * * cd /app && ./healthcheck.sh

# Lundi 7h — weekly report
0 7 * * 1 cd /app && ./weekly_report.sh

# Daily 2h — backup du volume /data (rotation 14 jours)
0 2 * * * cd /app && ./backup.sh

# Daily 3h — cleanup outputs (>7j) + logs (>14j) + rotation metrics.jsonl
0 3 * * * cd /app && ./cleanup.sh
